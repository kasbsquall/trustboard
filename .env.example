# === Local DataHub (generated in Step 1) ===
# GMS = Generalized Metadata Service. It is the backend that both the
# acryl-datahub SDK and the MCP Server talk to. The frontend UI runs on :9002,
# but the API and the MCP endpoint live on :8080.
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=your-personal-access-token

# Self-hosted MCP endpoint served by GMS (for an interactive HTTP connection
# from Claude Code). The SDK and the agents use DATAHUB_GMS_URL directly.
DATAHUB_MCP_URL=http://localhost:8080/mcp

# The MCP Server starts in read-only mode by default. The Scribe (Step 5) needs
# to write structured properties, so mutations have to be enabled. The Scribe
# uses the SDK directly and does not depend on this flag, but you need it if you
# explore mutations through MCP.
TOOLS_IS_MUTATION_ENABLED=true

# === Local database for the score history ===
# SQLite by default: no extra container, works right after cloning.
DATABASE_URL=sqlite:///./trustboard.db
# For Postgres instead, generate a password, start the container with it, and
# point DATABASE_URL at 127.0.0.1. There is deliberately no default password
# here: one committed to a repository protects nothing.
#   TRUSTBOARD_DB_PASSWORD=$(openssl rand -base64 24) docker compose up -d
# TRUSTBOARD_DB_PASSWORD=
# DATABASE_URL=postgresql://trustboard:<password>@127.0.0.1:5433/trustboard

# === Slack (Step 7) ===
SLACK_WEBHOOK_URL=

# === Backend ===
BACKEND_PORT=8000
