# === DataHub local (generado en el Paso 1) ===
# GMS = Generalized Metadata Service. Es el backend con el que hablan
# tanto el SDK acryl-datahub como el MCP Server. Frontend UI va en :9002,
# pero la API y el endpoint MCP viven en :8080.
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=tu-personal-access-token

# Endpoint MCP self-hosted servido por GMS (para conexion HTTP interactiva
# desde Claude Code). El SDK y los agentes usan DATAHUB_GMS_URL directamente.
DATAHUB_MCP_URL=http://localhost:8080/mcp

# El MCP Server arranca en modo solo-lectura por defecto. El Escriba (Paso 5)
# necesita escribir structured properties, asi que las mutaciones deben
# habilitarse. El Escribe usa el SDK directo, no depende de esta bandera,
# pero si exploras mutaciones via MCP la necesitas.
TOOLS_IS_MUTATION_ENABLED=true

# === Base de datos local para el historico de scores ===
# Alternativa SQLite (sin Docker): sqlite:///./trustboard.db
DATABASE_URL=postgresql://trustboard:trustboard@localhost:5433/trustboard

# === Slack (Paso 7) ===
SLACK_WEBHOOK_URL=

# === Backend ===
BACKEND_PORT=8000
